# ── Auth ─────────────────────────────────────────────────────────────
# Public origin. MUST match siteConfig.siteUrl exactly in production.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Stable across deploys, or open tabs break with
# "Failed to find Server Action" after every release.
# openssl rand -hex 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────
MONGODB_URL=mongodb://127.0.0.1:27017/master-mart

# ── Seed admin account (used by `npm run seed`) ──────────────────────
ADMIN_EMAIL=admin@master-mart.com
ADMIN_PASSWORD=

# ── Cloudinary (product image upload; base64 fallback if unset) ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (order invoice emails; logged to console if unset) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

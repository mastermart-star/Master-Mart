# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Full-Stack SQL Database & API Configuration
# ==========================================

# SQL Database Connection URL (Prisma ORM)
# In local development / AI Studio preview, SQLite is used natively:
DATABASE_URL="file:./master_mart_sql.db"
# For production deployment on Hostinger VPS / AWS with MySQL or PostgreSQL:
# DATABASE_URL="mysql://username:password@localhost:3306/master_mart"
# DATABASE_URL="postgresql://username:password@host:5432/master_mart"


# Admin Dashboard Password (Default is 9134)
ADMIN_JWT_SECRET="super-secret-admin-token-key-change-this"
JWT_SECRET="jwt-session-secret-key"

# Cloudinary Credentials for Product Image Upload
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Payment Gateways (bKash & SSLCommerz Sandbox or Live API Credentials)
BKASH_APP_KEY="sandbox_app_key"
BKASH_APP_SECRET="sandbox_app_secret"
BKASH_USERNAME="sandbox_username"
BKASH_PASSWORD="sandbox_password"

SSLCOMMERZ_STORE_ID="sandbox_store_id"
SSLCOMMERZ_STORE_PASSWORD="sandbox_store_password"
SSLCOMMERZ_IS_SANDBOX="true"

# Courier API Configurations (Pathao / Steadfast Courier)
STEADFAST_API_KEY="steadfast_api_key_here"
STEADFAST_SENDER_ID="sender_id_here"

# SMTP Email Configuration (Gmail / Mailgun / SendGrid)
# If provided, real emails will be sent on order completion!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
